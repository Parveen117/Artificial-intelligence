{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/formal-proof-gate-v1.schema.json",
  "title": "Formal Proof Gate v1 proof document",
  "type": "object",
  "required": ["version", "proof_id", "assumptions", "target", "steps", "conclusion_step"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "1.0.0"},
    "proof_id": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/formula"}},
    "target": {"$ref": "#/$defs/formula"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "conclusion_step": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "term": {
      "oneOf": [
        {"type": "integer"},
        {"type": "string", "minLength": 1},
        {"type": "object", "required": ["op", "value"], "additionalProperties": false, "properties": {"op": {"const": "const"}, "value": {"type": "integer"}}},
        {"type": "object", "required": ["op", "name"], "additionalProperties": false, "properties": {"op": {"const": "var"}, "name": {"type": "string", "minLength": 1}}},
        {"type": "object", "required": ["op", "arg"], "additionalProperties": false, "properties": {"op": {"const": "neg"}, "arg": {"$ref": "#/$defs/term"}}},
        {"type": "object", "required": ["op", "left", "right"], "additionalProperties": false, "properties": {"op": {"enum": ["add", "sub", "mul"]}, "left": {"$ref": "#/$defs/term"}, "right": {"$ref": "#/$defs/term"}}}
      ]
    },
    "formula": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object", "required": ["op", "name"], "additionalProperties": false, "properties": {"op": {"const": "atom"}, "name": {"type": "string", "minLength": 1}}},
        {"type": "object", "required": ["op", "left", "right"], "additionalProperties": false, "properties": {"op": {"enum": ["eq", "lt", "le"]}, "left": {"$ref": "#/$defs/term"}, "right": {"$ref": "#/$defs/term"}}},
        {"type": "object", "required": ["op", "arg"], "additionalProperties": false, "properties": {"op": {"const": "not"}, "arg": {"$ref": "#/$defs/formula"}}},
        {"type": "object", "required": ["op", "left", "right"], "additionalProperties": false, "properties": {"op": {"enum": ["and", "or", "implies"]}, "left": {"$ref": "#/$defs/formula"}, "right": {"$ref": "#/$defs/formula"}}}
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "rule", "premises", "conclusion"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule": {"enum": ["ASSUMPTION", "ARITHMETIC_EVAL", "EQ_SYMMETRY", "EQ_TRANSITIVITY", "AND_INTRO", "AND_ELIM_LEFT", "AND_ELIM_RIGHT", "MODUS_PONENS"]},
        "premises": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "conclusion": {"$ref": "#/$defs/formula"}
      }
    }
  }
}
