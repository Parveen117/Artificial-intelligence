{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/challenge-engine/result.schema.json",
  "title": "Challenge Engine Result",
  "type": "object",
  "required": ["engine_version", "result"],
  "properties": {
    "engine_version": {"type": "string"},
    "schema_version": {"type": "string"},
    "challenge_id": {"type": ["string", "null"]},
    "package": {"type": "string"},
    "mode": {"type": "string"},
    "result": {
      "enum": [
        "OBSERVED",
        "ADVERSARIAL_PASS",
        "CERTIFIED",
        "INCOMPLETE",
        "FAILED",
        "INVALID",
        "BLOCKED_SCOPE",
        "SEMANTICS_NOT_IN_SCOPE"
      ]
    },
    "formal_promotion": {"type": "boolean"},
    "challenge_genesis": {
      "type": "object",
      "properties": {
        "kind": {"const": "CHALLENGE_GENESIS"},
        "hash_algorithm": {"const": "sha256"},
        "genesis_hash": {"type": "string"},
        "parent": {"type": "null"},
        "accepted_claims": {"const": 0},
        "rules_frozen": {"const": true},
        "meaning": {"type": "string"},
        "contract": {"type": "object"}
      },
      "additionalProperties": true
    },
    "checks": {"type": "array"},
    "open_obligations": {"type": "array"},
    "failed_obligations": {"type": "array"},
    "blocked_obligations": {"type": "array"},
    "not_in_scope": {"type": "array"},
    "challenge_definition": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "license_boundary": {"type": "string"}
  },
  "additionalProperties": true
}
