{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/challenge-engine/challenge.schema.json",
  "title": "Challenge Engine Input",
  "type": "object",
  "required": ["challenge_id", "target"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "challenge_id": {"type": "string", "minLength": 1},
    "package": {"type": "string", "default": "math"},
    "mode": {"type": "string", "enum": ["exploratory", "adversarial", "certified"]},
    "target": {
      "type": "object",
      "required": ["statement"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "kind": {"type": "string"}
      },
      "additionalProperties": true
    },
    "scope": {"type": "object", "additionalProperties": true},
    "threat_model": {
      "type": "object",
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "break_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "false_acceptance",
              "blindness_escape",
              "scope_escape",
              "negative_control_escape",
              "invalid_promotion",
              "flow_consistency_escape",
              "ledger_integrity_failure"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "semantics": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["payload_only", "adapter_declared"], "default": "payload_only"}
      },
      "additionalProperties": true
    },
    "semantic_adapter": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "open"]}
      },
      "additionalProperties": true
    },
    "genesis": {
      "type": "object",
      "properties": {
        "expected_hash": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["pass", "fail", "open"]}
        },
        "additionalProperties": true
      }
    },
    "negative_controls": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "formal_adapter": {"type": "object", "additionalProperties": true},
    "flow": {"type": "object", "additionalProperties": true},
    "burden": {"type": "object", "additionalProperties": true},
    "completion": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
